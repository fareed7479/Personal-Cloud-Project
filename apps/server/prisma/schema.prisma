// Prisma schema for Personal Cloud Project (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  displayName String
  email       String?  @unique
  devices     Device[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Device {
  id            String    @id @default(uuid())
  deviceId      String    @unique
  deviceName    String
  platform      String    @default("unknown")
  appVersion    String?
  fingerprint   String?
  authTokenHash String?   @unique
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  pairedAt      DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())

  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deviceId])
  @@index([authTokenHash])
  @@index([userId])
}

model PairingChallenge {
  id               String    @id @default(uuid())
  pin              String    // 6-digit challenge PIN
  expiresAt        DateTime
  status           String    @default("pending") // "pending" | "approved" | "rejected" | "expired" | "consumed"
  clientDeviceId   String?
  clientDeviceName String?
  clientPlatform   String?
  issuedToken      String?   // Transferred once upon client polling after laptop approval
  attempts         Int       @default(0)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model StorageVolume {
  id          String   @id @default(uuid())
  name        String
  path        String   @unique
  isDefault   Boolean  @default(true)
  folders     Folder[]
  files       File[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Folder {
  id          String         @id @default(uuid())
  name        String
  path        String         @unique // Virtual relative path (e.g. "Documents" or "Photos/2026")
  parentId    String?
  parent      Folder?        @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]       @relation("SubFolders")
  files       File[]

  volumeId    String?
  volume      StorageVolume? @relation(fields: [volumeId], references: [id], onDelete: SetNull)

  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId])
  @@index([isDeleted])
  @@index([volumeId])
}

model File {
  id            String         @id @default(uuid())
  name          String
  extension     String         @default("")
  relativePath  String         @unique // Relative to storage root (e.g. "Documents/notes.txt")
  sizeBytes     BigInt
  mimeType      String         @default("application/octet-stream")
  category      String         @default("other") // image, video, audio, document, archive, other
  checksum      String?
  
  folderId      String?
  folder        Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)

  volumeId      String?
  volume        StorageVolume? @relation(fields: [volumeId], references: [id], onDelete: SetNull)

  hasThumbnail  Boolean        @default(false)
  thumbnailPath String?

  mtime         DateTime       @default(now()) // Filesystem modified time for smart rescan
  status        String         @default("active") // "active" | "trash" | "archived"
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([folderId])
  @@index([category])
  @@index([isDeleted])
  @@index([status])
  @@index([volumeId])
}

model TransferJob {
  id               String   @id @default(uuid())
  type             String   // "upload" | "download"
  fileName         String
  fileId           String?
  bytesTransferred BigInt   @default(0)
  totalBytes       BigInt
  status           String   @default("queued") // "queued" | "in_progress" | "completed" | "failed" | "cancelled"
  errorMessage     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model UploadSession {
  id              String   @id @default(uuid())
  fileName        String
  sizeBytes       BigInt
  mimeType        String   @default("application/octet-stream")
  chunkSize       Int      @default(1048576) // Default 1MB
  totalChunks     Int
  receivedChunks  String   @default("[]") // JSON serialized array of chunk numbers
  checksum        String?  // Optional client expected SHA-256
  folderId        String?
  tempDirPath     String
  status          String   @default("active") // "active" | "completed" | "aborted" | "expired"
  expiresAt       DateTime
  deviceId        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
}
