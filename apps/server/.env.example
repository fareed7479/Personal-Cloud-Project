# ==============================================================================
# Backend Server Configuration
# ==============================================================================

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Storage Root: Directory where actual files are stored on this laptop
# Can be relative to apps/server or an absolute path (e.g., C:/PersonalCloud)
STORAGE_ROOT=./storage_root

# SQLite Database Location
DATABASE_URL="file:./dev.db"

# CORS Allowed Origins (* allows mobile app during LAN development)
CORS_ORIGIN=*

# Server Display Name
SERVER_NAME="Personal Cloud Server"

# Logging Level: debug | info | warn | error
LOG_LEVEL=info
