# ==============================================================================
# Personal Cloud Project - Root Environment Configuration Example
# Copy to apps/server/.env for backend server configuration
# ==============================================================================

# Server Network Settings
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Storage Root Directory (Absolute or relative to apps/server)
# On Windows: C:/PersonalCloudStorage or ./storage_root
STORAGE_ROOT=./storage_root

# SQLite Database Location
DATABASE_URL="file:./dev.db"

# CORS configuration (allow requests from Expo dev clients & local networks)
CORS_ORIGIN=*

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Default Server Base URL for Mobile Client (e.g. Android Emulator: http://10.0.2.2:4000, or LAN IP: http://192.168.1.X:4000)
EXPO_PUBLIC_DEFAULT_SERVER_URL=http://10.0.2.2:4000
